    "billing:setup": "node billing/setup.mjs"
  },
  "dependencies": {
    "@vercel/functions": "3.10.3",
    "@waffo/pancake-ts": "0.26.0",
    "better-auth": "1.7.10",
    "express": "5.1.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.13.0",
    "nodemailer": "7.0.13",
    "pg": "8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
