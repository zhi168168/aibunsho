# Copy to .env locally. Never prefix secrets with VITE_.
# Default: DeepSeek auxiliary review, not a specialist AI detector.
DETECTION_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Set true after adding credentials to enable model requests.
DETECTION_ENABLED=false
# Optional specialist detector: set DETECTION_PROVIDER=copyleaks
# Obtain credentials from https://api.copyleaks.com/dashboard
COPYLEAKS_EMAIL=
COPYLEAKS_API_KEY=
# Sandbox returns test fixtures, NOT real detection. Set false only for live use.
COPYLEAKS_SANDBOX=true
# Production canonical URL, e.g. https://your-domain.example (no path)
SITE_URL=https://aibunsho.com
