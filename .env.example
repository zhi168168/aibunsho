# Copy to .env locally. Never prefix secrets with VITE_.
# Default: DeepSeek auxiliary review, not a specialist AI detector.
DETECTION_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Set true after adding credentials to enable model requests.
DETECTION_ENABLED=false
# Optional specialist detector: set DETECTION_PROVIDER=copyleaks
# Obtain credentials from https://api.copyleaks.com/dashboard
COPYLEAKS_EMAIL=
COPYLEAKS_API_KEY=
# Sandbox returns test fixtures, NOT real detection. Set false only for live use.
COPYLEAKS_SANDBOX=true
# Production canonical URL, e.g. https://your-domain.example (no path)
SITE_URL=https://aibunsho.com

# Independent account database and cookie secret (never reuse Typeflow tables).
ACCOUNT_ORIGIN=
DATABASE_URL=
DIRECT_DATABASE_URL=
BETTER_AUTH_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google redirect URI: https://aibunsho.com/api/auth/callback/google
# Local preview only: AUTH_DEV_MODE=true, ACCOUNT_ORIGIN=http://127.0.0.1:5173
# Local emails are saved in ignored work/aibunsho-accounts/mailbox.json.
AUTH_DEV_MODE=false

# Waffo server credentials; use independent aibunsho store/products.
WAFFO_ENVIRONMENT=test
WAFFO_MERCHANT_ID=
WAFFO_PRIVATE_KEY=
WAFFO_STORE_ID=
WAFFO_BASIC_PRODUCT_ID=
WAFFO_PRO_PRODUCT_ID=
CONTENT_SAFETY_ENABLED=false
WAFFO_CHECKOUT_ENABLED=false
# Production model requests: enable Waffo Prompt Sift input/output checks before paid launch.
# Products: monthly, paid introductory period trialDays=30.
# Basic USD 9.99, trialAmount 4.99; Pro USD 29.99, trialAmount 14.99.
# Webhook: https://aibunsho.com/api/billing/webhook
